# 0/1 Knapsack using Dynamic Programming
# Top-Down (Memoization) and Bottom-Up (Tabulation)

weights = [2, 1, 3, 2]
values = [12, 10, 20, 15]
capacity = 5
n = len(weights)


# Top-Down: Memoization
def knapsack_memo(n, capacity, memo):

    if n == 0 or capacity == 0:
        return 0

    if memo[n][capacity] != -1:
        return memo[n][capacity]

    if weights[n - 1] > capacity:
        memo[n][capacity] = knapsack_memo(n - 1, capacity, memo)

    else:
        include = values[n - 1] + knapsack_memo(
            n - 1, capacity - weights[n - 1], memo
        )

        exclude = knapsack_memo(n - 1, capacity, memo)

        memo[n][capacity] = max(include, exclude)

    return memo[n][capacity]


# Bottom-Up: Tabulation
def knapsack_tab(n, capacity):

    dp = [[0] * (capacity + 1) for _ in range(n + 1)]

    for i in range(1, n + 1):
        for w in range(1, capacity + 1):

            if weights[i - 1] <= w:
                take = values[i - 1] + dp[i - 1][w - weights[i - 1]]
                not_take = dp[i - 1][w]
                dp[i][w] = max(take, not_take)

            else:
                dp[i][w] = dp[i - 1][w]

    return dp[n][capacity]


# Main Program
memo = [[-1] * (capacity + 1) for _ in range(n + 1)]

print("Using Memoization:", knapsack_memo(n, capacity, memo))
print("Using Tabulation:", knapsack_tab(n, capacity))
